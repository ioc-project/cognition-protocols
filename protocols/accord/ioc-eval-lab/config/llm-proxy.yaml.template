# Template for the MAS Lab model endpoint. setup.sh fills in the two @...@ values
# and writes the result to .local/config/mas/llm-proxy.yaml.
apiVersion: infra/v1
kind: LLMProxy
metadata:
  name: llm-proxy
spec:
  proxy:
    api_base: env:OPENAI_BASE_URL
    api_key_env: OPENAI_API_KEY
    timeout: 240
  models:
    generation:
      # Without this, the model's output was cut off at 4096 tokens and the
      # ACCORD replies were truncated.
      max_tokens: @MAX_TOKENS@
    mappings:
      generic-model: "@LLM_MODEL_NAME@"
    defaults:
      llm: "@LLM_MODEL_NAME@"
